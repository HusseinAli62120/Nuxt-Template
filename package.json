{
  "name": "nuxt-template",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --dotenv .env.development",
    "test": "nuxt dev --dotenv .env.test",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:generate:dev": "dotenv -e .env.development -- prisma generate ",
    "db:push:dev": "dotenv -e .env.development -- prisma db push ",
    "db:studio:dev": "dotenv -e .env.development -- prisma studio ",
    "db:generate:test": "dotenv -e .env.test -- prisma generate ",
    "db:push:test": "dotenv -e .env.test -- prisma db push ",
    "db:studio:test": "dotenv -e .env.test -- prisma studio ",
    "db:generate:production": "dotenv -e .env -- prisma generate ",
    "db:push:production": "dotenv -e .env -- prisma db push ",
    "db:studio:production": "dotenv -e .env -- prisma studio "
  },
  "dependencies": {
    "@lucide/vue": "^1.17.0",
    "@nuxtjs/color-mode": "^4.0.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tailwindcss/vite": "^4.3.0",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "nuxt": "^4.4.6",
    "nuxt-auth-utils": "^0.5.29",
    "pg": "^8.21.0",
    "reka-ui": "^2.9.8",
    "shadcn-nuxt": "^2.7.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "^7.8.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  }
}
